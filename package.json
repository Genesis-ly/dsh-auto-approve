{
  "name": "dsh-auto-approve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic auto-approval for safe DSH sandbox escalations: grants only writes under your plugin directories, behind a hard denylist and with a full audit log. Everything else still asks.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "approval",
    "automation",
    "security"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/rules.test.mjs && node test/plugin.test.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
